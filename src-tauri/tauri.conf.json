{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recast",
  "version": "0.1.0",
  "identifier": "com.miguelsilva.recast",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recast",
        "width": 920,
        "height": 640,
        "minWidth": 640,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "copyright": "Copyright \u00a9 2026 Miguel Silva",
    "shortDescription": "Convert images, video, GIFs and audio offline",
    "longDescription": "Recast converts images, video, animated GIFs and audio on your own computer using FFmpeg. No uploads, no file-size limits."
  }
}
